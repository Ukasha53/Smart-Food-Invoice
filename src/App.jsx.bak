const SUPABASE_URL  = "https://rfrfxcouzbnrpwwfjxpx.supabase.co";
const SUPABASE_ANON_KEY = "sb_publishable_xYK21XX_Kh5uH-uygTXGhg_CfXpoVvh";
// ============================================================

import { useEffect, useState, useCallback, useRef } from "react";
import { createClient } from "@supabase/supabase-js";
import jsPDF from "jspdf";
import autoTable from "jspdf-autotable";
import {
  ShoppingCart,
  Utensils,
  Plus,
  Minus,
  Trash2,
  Upload,
  Edit3,
  X,
  CheckCircle,
  AlertCircle,
  Download,
  PackageOpen,
  ChefHat,
  Receipt,
  ImagePlus,
  Save,
  RefreshCw,
} from "lucide-react";

// Supabase client — wrapped so the UI still renders with placeholder credentials
let supabase = null;
try {
  supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
} catch {
  console.warn("Supabase not configured yet — replace the placeholder URL and anon key.");
}

const STORAGE_BUCKET = "food-images";

// Utility helpers
const generateInvoiceNo = () =>
  `INV-${Date.now().toString(36).toUpperCase()}-${Math.random()
    .toString(36)
    .slice(2, 6)
    .toUpperCase()}`;

const formatCurrency = (n) =>
  new Intl.NumberFormat("en-PK", {
    style: "currency",
    currency: "PKR",
    minimumFractionDigits: 0,
  }).format(n);

// Toast component
function Toast({ toasts }) {
  return (
    <div className="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none">
      {toasts.map((t) => (
        <div
          key={t.id}
          className={`flex items-center gap-2 px-4 py-3 rounded-xl shadow-lg text-sm font-medium pointer-events-auto
            ${t.type === "success" ? "bg-emerald-600 text-white" : "bg-red-600 text-white"}`}
        >
          {t.type === "success" ? <CheckCircle size={16} /> : <AlertCircle size={16} />}
          {t.message}
        </div>
      ))}
    </div>
  );
}

// Placeholder image
const PlaceholderImg = () => (
  <div className="w-full h-44 bg-gradient-to-br from-slate-700 to-slate-800 flex items-center justify-center rounded-t-2xl">
    <Utensils className="text-slate-500" size={48} />
  </div>
);

// Food Card
function FoodCard({ item, onSelect, onEdit, onDelete }) {
  return (
    <div className="bg-slate-800 rounded-2xl shadow-lg overflow-hidden flex flex-col border border-slate-700 hover:border-amber-500 transition-all duration-300 group hover:shadow-amber-900/30 hover:shadow-xl hover:-translate-y-0.5">
      {item.image_url ? (
        <img
          src={item.image_url}
          alt={item.name}
          className="w-full h-44 object-cover rounded-t-2xl transition-transform duration-500 group-hover:scale-105"
        />
      ) : (
        <PlaceholderImg />
      )}
      <div className="p-4 flex flex-col flex-1">
        <h3 className="text-white font-semibold text-base leading-tight mb-1 truncate">{item.name}</h3>
        <p className="text-amber-400 font-bold text-lg mb-3">{formatCurrency(item.price)}</p>
        <div className="mt-auto flex gap-2">
          <button
            onClick={() => onSelect(item)}
            className="flex-1 bg-amber-500 hover:bg-amber-400 text-slate-900 font-semibold text-xs py-2 px-3 rounded-lg transition-colors duration-200 flex items-center justify-center gap-1"
          >
            <Plus size={14} /> Add to Order
          </button>
          <button
            onClick={() => onEdit(item)}
            className="p-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-300 transition-colors"
          >
            <Edit3 size={14} />
          </button>
          <button
            onClick={() => onDelete(item.id)}
            className="p-2 rounded-lg bg-slate-700 hover:bg-red-600 text-slate-300 hover:text-white transition-colors"
          >
            <Trash2 size={14} />
          </button>
        </div>
      </div>
    </div>
  );
}

// Item Form Modal
function ItemFormModal({ initial, onClose, onSaved, addToast }) {
  const [name, setName] = useState(initial?.name ?? "");
  const [price, setPrice] = useState(initial?.price ?? "");
  const [imageFile, setImageFile] = useState(null);
  const [previewUrl, setPreviewUrl] = useState(initial?.image_url ?? null);
  const [loading, setLoading] = useState(false);
  const fileRef = useRef();

  const handleFileChange = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    setImageFile(file);
    setPreviewUrl(URL.createObjectURL(file));
  };

  const validate = () => {
    if (!name.trim()) return "Item name is required.";
    if (!price || isNaN(Number(price)) || Number(price) <= 0) return "A valid price is required.";
    return null;
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    const err = validate();
    if (err) { addToast(err, "error"); return; }
    if (!supabase) { addToast("Supabase not configured. Please add your credentials.", "error"); return; }

    setLoading(true);

    try {
      let imageUrl = initial?.image_url ?? null;

      if (imageFile) {
        const ext = imageFile.name.split(".").pop();
        const filePath = `public/${Date.now()}.${ext}`;
        const { error: upErr } = await supabase.storage
          .from(STORAGE_BUCKET)
          .upload(filePath, imageFile, { upsert: true });
        if (upErr) throw upErr;
        const { data: urlData } = supabase.storage.from(STORAGE_BUCKET).getPublicUrl(filePath);
        imageUrl = urlData.publicUrl;
      }

      const payload = { name: name.trim(), price: Number(price), image_url: imageUrl };

      if (initial?.id) {
        const { error } = await supabase.from("food_items").update(payload).eq("id", initial.id);
        if (error) throw error;
        addToast("Item updated successfully!", "success");
      } else {
        const { error } = await supabase.from("food_items").insert([payload]);
        if (error) throw error;
        addToast("Item added successfully!", "success");
      }

      onSaved();
      onClose();
    } catch (err) {
      addToast(err.message ?? "Something went wrong.", "error");
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="fixed inset-0 z-40 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4">
      <div className="bg-slate-800 rounded-2xl shadow-2xl w-full max-w-md border border-slate-700">
        <div className="flex items-center justify-between px-6 py-4 border-b border-slate-700">
          <h2 className="text-white font-bold text-lg flex items-center gap-2">
            <ChefHat className="text-amber-400" size={20} />
            {initial?.id ? "Edit Food Item" : "Add New Item"}
          </h2>
          <button onClick={onClose} className="text-slate-400 hover:text-white transition-colors">
            <X size={20} />
          </button>
        </div>

        <form onSubmit={handleSubmit} className="p-6 flex flex-col gap-5">
          <div
            className="w-full h-40 rounded-xl border-2 border-dashed border-slate-600 hover:border-amber-500 overflow-hidden flex items-center justify-center cursor-pointer bg-slate-900 transition-colors relative"
            onClick={() => fileRef.current.click()}
          >
            {previewUrl ? (
              <img src={previewUrl} alt="preview" className="w-full h-full object-cover" />
            ) : (
              <div className="flex flex-col items-center gap-2 text-slate-500">
                <ImagePlus size={36} />
                <span className="text-sm">Click to upload image</span>
              </div>
            )}
            {previewUrl && (
              <div className="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 hover:opacity-100 transition-opacity">
                <Upload className="text-white" size={28} />
              </div>
            )}
            <input type="file" ref={fileRef} accept="image/*" className="hidden" onChange={handleFileChange} />
          </div>

          <div>
            <label className="block text-sm font-medium text-slate-400 mb-1.5">Item Name *</label>
            <input
              type="text"
              value={name}
              onChange={(e) => setName(e.target.value)}
              placeholder="e.g. Chicken Biryani"
              className="w-full bg-slate-900 text-white border border-slate-600 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-amber-500 transition-colors placeholder-slate-600"
            />
          </div>

          <div>
            <label className="block text-sm font-medium text-slate-400 mb-1.5">Price (PKR) *</label>
            <input
              type="number"
              value={price}
              onChange={(e) => setPrice(e.target.value)}
              placeholder="e.g. 350"
              min="1"
              className="w-full bg-slate-900 text-white border border-slate-600 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-amber-500 transition-colors placeholder-slate-600"
            />
          </div>

          <div className="flex gap-3 pt-1">
            <button
              type="button"
              onClick={onClose}
              className="flex-1 py-2.5 rounded-xl bg-slate-700 hover:bg-slate-600 text-white text-sm font-medium transition-colors"
            >
              Cancel
            </button>
            <button
              type="submit"
              disabled={loading}
              className="flex-1 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 disabled:bg-amber-800 text-slate-900 font-bold text-sm transition-colors flex items-center justify-center gap-2"
            >
              {loading ? <RefreshCw size={15} className="animate-spin" /> : <Save size={15} />}
              {initial?.id ? "Update Item" : "Save Item"}
            </button>
          </div>
        </form>
      </div>
    </div>
  );
}

// Cart Panel
function CartPanel({ cart, onIncrease, onDecrease, onRemove, onDownloadPDF }) {
  const grandTotal = cart.reduce((sum, ci) => sum + ci.price * ci.qty, 0);

  return (
    <aside className="w-full lg:w-96 bg-slate-800 rounded-2xl border border-slate-700 flex flex-col shadow-xl overflow-hidden">
      <div className="px-5 py-4 border-b border-slate-700 flex items-center gap-3 bg-gradient-to-r from-slate-800 to-slate-900">
        <div className="p-2 bg-amber-500/20 rounded-xl">
          <Receipt className="text-amber-400" size={20} />
        </div>
        <div>
          <h2 className="text-white font-bold text-base">Live Order Summary</h2>
          <p className="text-slate-400 text-xs">
            {cart.length === 0 ? "No items yet" : `${cart.reduce((s, c) => s + c.qty, 0)} item(s) added`}
          </p>
        </div>
        {cart.length > 0 && (
          <span className="ml-auto bg-amber-500 text-slate-900 text-xs font-bold px-2.5 py-1 rounded-full">
            {cart.reduce((s, c) => s + c.qty, 0)}
          </span>
        )}
      </div>

      <div className="flex-1 overflow-y-auto px-4 py-3 space-y-3" style={{ maxHeight: "calc(100vh - 300px)" }}>
        {cart.length === 0 ? (
          <div className="flex flex-col items-center justify-center py-16 text-center gap-3">
            <PackageOpen className="text-slate-600" size={52} />
            <p className="text-slate-500 text-sm font-medium">Your order is empty</p>
            <p className="text-slate-600 text-xs">Select items from the menu to build your order.</p>
          </div>
        ) : (
          cart.map((ci) => (
            <div
              key={ci.id}
              className="bg-slate-900 rounded-xl p-3 flex items-center gap-3 border border-slate-700/50"
            >
              {ci.image_url ? (
                <img src={ci.image_url} alt={ci.name} className="w-12 h-12 rounded-lg object-cover flex-shrink-0" />
              ) : (
                <div className="w-12 h-12 rounded-lg bg-slate-700 flex items-center justify-center flex-shrink-0">
                  <Utensils size={18} className="text-slate-500" />
                </div>
              )}
              <div className="flex-1 min-w-0">
                <p className="text-white text-sm font-semibold truncate">{ci.name}</p>
                <p className="text-amber-400 text-xs font-medium">{formatCurrency(ci.price)} each</p>
                <p className="text-slate-400 text-xs">Total: {formatCurrency(ci.price * ci.qty)}</p>
              </div>
              <div className="flex items-center gap-1.5 flex-shrink-0">
                <button
                  onClick={() => onDecrease(ci.id)}
                  className="w-7 h-7 rounded-lg bg-slate-700 hover:bg-red-600 text-white flex items-center justify-center transition-colors"
                >
                  <Minus size={12} />
                </button>
                <span className="text-white font-bold text-sm w-6 text-center">{ci.qty}</span>
                <button
                  onClick={() => onIncrease(ci.id)}
                  className="w-7 h-7 rounded-lg bg-slate-700 hover:bg-emerald-600 text-white flex items-center justify-center transition-colors"
                >
                  <Plus size={12} />
                </button>
                <button
                  onClick={() => onRemove(ci.id)}
                  className="w-7 h-7 rounded-lg bg-slate-700 hover:bg-red-700 text-slate-400 hover:text-white flex items-center justify-center transition-colors ml-1"
                >
                  <X size={12} />
                </button>
              </div>
            </div>
          ))
        )}
      </div>

      <div className="px-5 py-4 border-t border-slate-700 bg-slate-900/50 space-y-4">
        <div className="flex items-center justify-between">
          <span className="text-slate-300 text-sm font-medium">Grand Total</span>
          <span className="text-amber-400 font-extrabold text-2xl tabular-nums">
            {formatCurrency(grandTotal)}
          </span>
        </div>
        <button
          onClick={onDownloadPDF}
          disabled={cart.length === 0}
          className="w-full py-3 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 disabled:from-slate-700 disabled:to-slate-700 disabled:text-slate-500 text-slate-900 disabled:cursor-not-allowed font-bold text-sm transition-all duration-200 flex items-center justify-center gap-2 shadow-lg shadow-amber-900/30"
        >
          <Download size={16} />
          Download PDF Bill
        </button>
      </div>
    </aside>
  );
}

// PDF Generator
function generatePDF(cart) {
  if (cart.length === 0) return;

  const doc = new jsPDF({ unit: "mm", format: "a4" });
  const pageW = doc.internal.pageSize.getWidth();
  const invoiceNo = generateInvoiceNo();
  const dateStr = new Date().toLocaleDateString("en-PK", {
    year: "numeric", month: "long", day: "numeric",
  });
  const grandTotal = cart.reduce((s, c) => s + c.price * c.qty, 0);

  // Header background
  doc.setFillColor(15, 23, 42);
  doc.rect(0, 0, pageW, 48, "F");

  // Company Name
  doc.setFont("helvetica", "bold");
  doc.setFontSize(22);
  doc.setTextColor(251, 191, 36);
  doc.text("AL RASHID FOOD COMPANY", pageW / 2, 18, { align: "center" });

  // Tagline
  doc.setFont("helvetica", "normal");
  doc.setFontSize(9);
  doc.setTextColor(148, 163, 184);
  doc.text("Premium Quality Food Catering & Dining", pageW / 2, 26, { align: "center" });

  // Divider
  doc.setDrawColor(251, 191, 36);
  doc.setLineWidth(0.6);
  doc.line(14, 31, pageW - 14, 31);

  // Invoice label
  doc.setFont("helvetica", "bold");
  doc.setFontSize(10);
  doc.setTextColor(255, 255, 255);
  doc.text("INVOICE", 14, 41);

  // Invoice meta
  doc.setFont("helvetica", "normal");
  doc.setFontSize(8.5);
  doc.setTextColor(200, 200, 200);
  doc.text(`Invoice No: ${invoiceNo}`, pageW - 14, 36, { align: "right" });
  doc.text(`Date: ${dateStr}`, pageW - 14, 43, { align: "right" });

  // Table
  const tableRows = cart.map((ci, i) => [
    i + 1,
    ci.name,
    `PKR ${ci.price.toLocaleString()}`,
    ci.qty,
    `PKR ${(ci.price * ci.qty).toLocaleString()}`,
  ]);

  autoTable(doc, {
    startY: 56,
    head: [["#", "Item Name", "Rate", "Qty", "Line Total"]],
    body: tableRows,
    styles: { font: "helvetica", fontSize: 10, cellPadding: 4, textColor: [30, 41, 59] },
    headStyles: {
      fillColor: [15, 23, 42],
      textColor: [251, 191, 36],
      fontStyle: "bold",
      halign: "center",
    },
    columnStyles: {
      0: { halign: "center", cellWidth: 12 },
      2: { halign: "right" },
      3: { halign: "center", cellWidth: 16 },
      4: { halign: "right" },
    },
    alternateRowStyles: { fillColor: [241, 245, 249] },
    tableLineColor: [203, 213, 225],
    tableLineWidth: 0.2,
    margin: { left: 14, right: 14 },
  });

  const finalY = doc.lastAutoTable.finalY + 8;

  // Grand Total block
  doc.setFillColor(15, 23, 42);
  doc.roundedRect(pageW - 14 - 70, finalY - 6, 70, 16, 3, 3, "F");
  doc.setFont("helvetica", "bold");
  doc.setFontSize(11);
  doc.setTextColor(251, 191, 36);
  doc.text("GRAND TOTAL:", pageW - 14 - 38, finalY + 4);
  doc.setFontSize(12);
  doc.setTextColor(255, 255, 255);
  doc.text(`PKR ${grandTotal.toLocaleString()}`, pageW - 14 - 3, finalY + 4, { align: "right" });

  // Footer
  const footerY = doc.internal.pageSize.getHeight() - 14;
  doc.setFont("helvetica", "normal");
  doc.setFontSize(8);
  doc.setTextColor(148, 163, 184);
  doc.text(
    "Thank you for choosing Al Rashid Food Company — Taste the Tradition!",
    pageW / 2,
    footerY,
    { align: "center" }
  );
  doc.setDrawColor(203, 213, 225);
  doc.setLineWidth(0.3);
  doc.line(14, footerY - 4, pageW - 14, footerY - 4);

  doc.save(`AlRashid_Invoice_${invoiceNo}.pdf`);
}

// Main App
export default function App() {
  const [items, setItems] = useState([]);
  const [loading, setLoading] = useState(true);
  const [cart, setCart] = useState([]);
  const [showModal, setShowModal] = useState(false);
  const [editItem, setEditItem] = useState(null);
  const [toasts, setToasts] = useState([]);
  const [search, setSearch] = useState("");

  const addToast = useCallback((message, type = "success") => {
    const id = Date.now();
    setToasts((p) => [...p, { id, message, type }]);
    setTimeout(() => setToasts((p) => p.filter((t) => t.id !== id)), 3500);
  }, []);

  const fetchItems = useCallback(async () => {
    if (!supabase) { setLoading(false); return; }
    setLoading(true);
    const { data, error } = await supabase
      .from("food_items")
      .select("*")
      .order("id", { ascending: false });
    if (error) addToast(error.message, "error");
    else setItems(data ?? []);
    setLoading(false);
  }, [addToast]);

  useEffect(() => { fetchItems(); }, [fetchItems]);

  const handleDelete = async (id) => {
    if (!supabase) { addToast("Supabase not configured.", "error"); return; }
    if (!window.confirm("Delete this item permanently?")) return;
    const { error } = await supabase.from("food_items").delete().eq("id", id);
    if (error) addToast(error.message, "error");
    else { addToast("Item deleted.", "success"); fetchItems(); }
  };

  const addToCart = (item) => {
    setCart((prev) => {
      const existing = prev.find((c) => c.id === item.id);
      if (existing) return prev.map((c) => c.id === item.id ? { ...c, qty: c.qty + 1 } : c);
      return [...prev, { ...item, qty: 1 }];
    });
    addToast(`${item.name} added to order!`, "success");
  };

  const increaseQty = (id) => setCart((p) => p.map((c) => c.id === id ? { ...c, qty: c.qty + 1 } : c));
  const decreaseQty = (id) =>
    setCart((p) => {
      const updated = p.map((c) => c.id === id ? { ...c, qty: c.qty - 1 } : c);
      return updated.filter((c) => c.qty > 0);
    });
  const removeFromCart = (id) => setCart((p) => p.filter((c) => c.id !== id));

  const openEdit = (item) => { setEditItem(item); setShowModal(true); };
  const openAdd  = () => { setEditItem(null); setShowModal(true); };

  const filtered = items.filter((i) =>
    i.name.toLowerCase().includes(search.toLowerCase())
  );

  const isConfigured = supabase !== null;

  return (
    <div className="min-h-screen bg-slate-950 text-white font-sans">
      <Toast toasts={toasts} />

      {/* Setup banner shown when credentials are placeholders */}
      {!isConfigured && (
        <div className="bg-amber-500 text-slate-900 text-sm font-semibold px-4 py-2.5 flex items-center justify-center gap-2">
          <AlertCircle size={16} />
          Supabase not configured — open <code className="bg-amber-600/30 px-1.5 py-0.5 rounded font-mono text-xs">src/App.jsx</code> and replace <code className="bg-amber-600/30 px-1.5 py-0.5 rounded font-mono text-xs">SUPABASE_URL</code> and <code className="bg-amber-600/30 px-1.5 py-0.5 rounded font-mono text-xs">SUPABASE_ANON_KEY</code> with your project credentials.
        </div>
      )}

      {showModal && (
        <ItemFormModal
          initial={editItem}
          onClose={() => { setShowModal(false); setEditItem(null); }}
          onSaved={fetchItems}
          addToast={addToast}
        />
      )}

      {/* HEADER */}
      <header className="bg-gradient-to-r from-slate-900 via-slate-900 to-slate-800 border-b border-slate-700/60 sticky top-0 z-30 shadow-lg">
        <div className="max-w-screen-2xl mx-auto px-5 py-3 flex items-center justify-between">
          <div className="flex items-center gap-3">
            <div className="p-2.5 bg-amber-500 rounded-xl shadow-lg shadow-amber-900/40">
              <ChefHat size={24} className="text-slate-900" />
            </div>
            <div>
              <h1 className="text-xl font-extrabold tracking-tight">
                <span className="text-amber-400">Al Rashid</span>{" "}
                <span className="text-white">Food Company</span>
              </h1>
              <p className="text-slate-400 text-xs">Menu Management & Billing System</p>
            </div>
          </div>
          <button
            onClick={openAdd}
            className="flex items-center gap-2 bg-amber-500 hover:bg-amber-400 text-slate-900 font-bold text-sm px-4 py-2.5 rounded-xl transition-all duration-200 shadow-md shadow-amber-900/30"
          >
            <Plus size={16} /> Add Item
          </button>
        </div>
      </header>

      {/* MAIN */}
      <main className="max-w-screen-2xl mx-auto px-5 py-6 flex flex-col lg:flex-row gap-6">
        {/* Menu section */}
        <section className="flex-1 min-w-0">
          <div className="mb-5 flex items-center gap-3">
            <div className="relative flex-1 max-w-sm">
              <Utensils size={15} className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-500" />
              <input
                type="text"
                placeholder="Search menu items..."
                value={search}
                onChange={(e) => setSearch(e.target.value)}
                className="w-full bg-slate-800 text-white border border-slate-700 rounded-xl pl-9 pr-4 py-2.5 text-sm focus:outline-none focus:border-amber-500 transition-colors placeholder-slate-600"
              />
            </div>
            <button
              onClick={fetchItems}
              title="Refresh"
              className="p-2.5 bg-slate-800 hover:bg-slate-700 border border-slate-700 rounded-xl transition-colors"
            >
              <RefreshCw size={15} className={`text-slate-400 ${loading ? "animate-spin" : ""}`} />
            </button>
            <span className="text-slate-500 text-sm">
              {filtered.length} item{filtered.length !== 1 ? "s" : ""}
            </span>
          </div>

          {loading ? (
            <div className="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4">
              {Array.from({ length: 8 }).map((_, i) => (
                <div key={i} className="bg-slate-800 rounded-2xl animate-pulse">
                  <div className="h-44 bg-slate-700 rounded-t-2xl" />
                  <div className="p-4 space-y-2">
                    <div className="h-4 bg-slate-700 rounded w-3/4" />
                    <div className="h-4 bg-slate-700 rounded w-1/2" />
                    <div className="h-8 bg-slate-700 rounded mt-3" />
                  </div>
                </div>
              ))}
            </div>
          ) : filtered.length === 0 ? (
            <div className="flex flex-col items-center justify-center py-32 gap-4">
              <PackageOpen className="text-slate-700" size={64} />
              <p className="text-slate-500 font-medium text-lg">
                {search ? "No items match your search." : "No food items yet. Add one!"}
              </p>
            </div>
          ) : (
            <div className="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 gap-4">
              {filtered.map((item) => (
                <FoodCard
                  key={item.id}
                  item={item}
                  onSelect={addToCart}
                  onEdit={openEdit}
                  onDelete={handleDelete}
                />
              ))}
            </div>
          )}
        </section>

        {/* Cart Panel */}
        <CartPanel
          cart={cart}
          onIncrease={increaseQty}
          onDecrease={decreaseQty}
          onRemove={removeFromCart}
          onDownloadPDF={() => generatePDF(cart)}
        />
      </main>
    </div>
  );
}
